{
  "name": "decorarte-catalogo",
  "private": true,
  "type": "module",
  "description": "Catálogo digital de Decorarte (GitHub Pages + Google Sheets + Apps Script)",
  "scripts": {
    "servir": "node tests/servidor.js",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:navegador": "playwright test --project=celular --project=iphone",
    "test:todo": "npm test && npm run test:navegador",
    "capturas": "playwright test --project=capturas",
    "ejemplos": "node tests/generar-ejemplos.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
